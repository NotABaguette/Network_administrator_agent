# Out-of-band box configuration. Copy to deploy/oob/.env on the OOB box only.
#
# There are no device credentials here and there must never be any: this box
# probes, it does not log in to anything. If it is stolen, the attacker gets a
# Telegram bot token and a list of IP addresses.

# This box's address on the MANAGEMENT VLAN. Alertmanager gossip advertises it
# to the main Alertmanager, which must be able to reach it back on 9094.
OOB_ADVERTISE_ADDR=10.0.0.9

# The main Alertmanager, for --cluster.peer. Its host must publish 9094.
MAIN_ALERTMANAGER_HOST=10.0.10.10

# The dead-man service this box pings while it can see the WAN. Use a SECOND
# check on the same service as mgmt-01's, not the same URL: two independent
# checks let the owner tell "mgmt-01 stopped" from "the site stopped".
OOB_HEARTBEAT_URL=https://hc-ping.com/CHANGE-ME-OOB-CHECK-UUID

# What counts as "the WAN is visible". Three anycast resolvers on three
# different networks; one of them being down is not an outage.
WAN_CHECK_HOSTS=1.1.1.1 9.9.9.9 8.8.8.8
HEARTBEAT_INTERVAL_SECONDS=300

# Owner chat for the direct Telegram receiver. The bot TOKEN goes in the file
# deploy/oob/telegram_token (mode 0600), not here, so it is not in the
# environment of every container.
TELEGRAM_CHAT_ID=000000000
