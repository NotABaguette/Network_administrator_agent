# Copy to deploy/.env. These are platform-internal credentials only; device and
# API secrets live in secrets/*.enc.yaml via SOPS.
POSTGRES_USER=infra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infra
NETBOX_SECRET_KEY=change-me-50-random-chars-minimum-xxxxxxxxxxxxxxxxxxxxxx
NETBOX_SUPERUSER=admin
NETBOX_SUPERUSER_PASSWORD=change-me
NETBOX_API_TOKEN=0123456789abcdef0123456789abcdef01234567
GRAFANA_ADMIN_PASSWORD=change-me
SOPS_AGE_KEY_FILE=/home/admin/.config/sops/age/keys.txt

# infra_agent settings (prefix INFRA_)
INFRA_POSTGRES_DSN=postgresql://infra:change-me@postgres:5432/infra
INFRA_NETBOX_URL=http://netbox:8080
INFRA_NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567
INFRA_PROMETHEUS_URL=http://prometheus:9090
INFRA_LOKI_URL=http://loki:3100
INFRA_ALERTMANAGER_URL=http://alertmanager:9093
INFRA_FROZEN=0
INFRA_LLM_MODEL=claude-opus-5
